        // DOM elements
        const recentBillsHeader = document.getElementById('recentBillsHeader');
        const recentBillsContent = document.getElementById('recentBillsContent');
        const recentBillsGrid = document.getElementById('recentBillsGrid');
        const searchResultsSection = document.getElementById('searchResultsSection');
