// Function to download a bill as PDF or text
function downloadBill(billId, format) {
    const bill = billsData.find(b => b.id === billId);
    if (!bill) return;
    
    if (format === 'pdf') {
        // In a real application, you would generate a PDF
        alert(`Generating PDF for Bill #${billId}...\nThis would create a PDF in a real application.`);
    } else if (format === 'text') {
        // Create a text representation of the bill
        let content = `BILL #${bill.id}\n`;
        content += `Date: ${bill.date} ${bill.time}\n`;
        content += `Customer: ${bill.name}\n`;
        content += `Phone: ${bill.phone}\n\n`;
        content += `ITEMS:\n`;
        content += `${'Item'.padEnd(20)} ${'Qty'.padEnd(5)} ${'Price'.padEnd(10)} ${'Total'.padEnd(10)}\n`;
        content += `${'-'.repeat(50)}\n`;
        
        bill.items.forEach(item => {
            content += `${item.name.padEnd(20)} ${item.quantity.toString().padEnd(5)} ₹${item.price.toFixed(2).padEnd(10)} ₹${item.total.toFixed(2).padEnd(10)}\n`;
        });
        
        content += `${'-'.repeat(50)}\n`;
        content += `${'Subtotal:'.padEnd(35)} ₹${bill.subtotal.toFixed(2)}\n`;
        content += `${'Tax:'.padEnd(35)} ₹${bill.tax.toFixed(2)}\n`;
        content += `${'TOTAL:'.padEnd(35)} ₹${bill.grandtotal.toFixed(2)}\n`;
        
        // Create a download link
        const element = document.createElement('a');
        element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(content));
        element.setAttribute('download', `Bill_${billId}.txt`);
        element.style.display = 'none';
        document.body.appendChild(element);
        element.click();
        document.body.removeChild(element);
    }
}

// Function to search bills
function searchBills() {
    const searchTerm = billSearch.value.toLowerCase().trim();
    const searchOption = document.querySelector('input[name="searchOption"]:checked').value;
    
    if (!searchTerm) {
        searchResultsSection.style.display = 'none';
        return;
    }
    
    // Clear previous search results
    searchResultsGrid.innerHTML = '';
    
    // Filter bills based on search criteria
    const filteredBills = billsData.filter(bill => {
        if (searchOption === 'name') {
            return bill.name.toLowerCase().includes(searchTerm);
        } else if (searchOption === 'phone') {
            return bill.phone.includes(searchTerm);
        } else if (searchOption === 'id') {
            return bill.id.includes(searchTerm);
        }
        return false;
    });
    
    // Show or hide search results section
    if (filteredBills.length > 0) {
        filteredBills.forEach(bill => {
            searchResultsGrid.appendChild(createBillCard(bill));
        });
        searchResultsSection.style.display = 'block';
        
        // Open the dropdown if it's closed
        const icon = searchResultsHeader.querySelector('.dropdown-icon');
        searchResultsContent.style.display = 'block';
        icon.textContent = '▼';
        icon.classList.add('open');
    } else {
        searchResultsGrid.innerHTML = '<div style="padding: 20px; text-align: center; width: 100%;">No results found</div>';
        searchResultsSection.style.display = 'block';
    }
}

