// Function to sort bills
function sortBills() {
    const sortOption = sortSelect.value;
    
    billsData.sort((a, b) => {
        if (sortOption === 'date') {
            // Sort by date (assuming format is DD-MM-YYYY)
            const [dayA, monthA, yearA] = a.date.split('-');
            const [dayB, monthB, yearB] = b.date.split('-');
            
            // Convert to YYYY-MM-DD format for proper comparison
            const dateA = new Date(`${yearA}-${monthA}-${dayA} ${a.time}`);
            const dateB = new Date(`${yearB}-${monthB}-${dayB} ${b.time}`);
            
            return dateB - dateA; // Most recent first
        } else if (sortOption === 'id') {
            // Sort by ID (assuming numeric or alphanumeric)
            return parseInt(b.id) - parseInt(a.id); // Highest ID first
        } else if (sortOption === 'total') {
            // Sort by grand total
            return b.grandtotal - a.grandtotal; // Highest amount first
        }
        return 0;
    });
    
    // Re-render bills
    displayBills();
}

